# =====================================================================
# MarketPos Admin API — konfigurasi lokal (Opsi B)
# Salin file ini menjadi .env lalu isi nilainya.
#
# PERINGATAN:
# - File .env TIDAK boleh di-commit.
# - SERVICE_ROLE_KEY hanya boleh dipakai di server lokal, JANGAN pernah
#   dimasukkan ke variabel VITE_* milik admin-web.
# =====================================================================

# Wajib diisi dari Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.isi-service-role-key

# Server hanya mendengarkan alamat loopback.
HOST=127.0.0.1
PORT=8787

# Asal browser yang diizinkan (pisahkan dengan koma).
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Kredensial login console. Ganti password sebelum dipakai di luar demo lokal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Opsional. Jika dikosongkan, token acak dibuat setiap server start dan
# diberikan ke console lewat respons login.
# API_TOKEN=isi-token-acak-panjang

# Cache query baca (milidetik) agar banyak tab tidak membebani database.
CACHE_TTL_MS=30000

# Batas baris yang boleh dipindai per permintaan. Jika terlampaui, endpoint
# mengembalikan error dan menyarankan migrasi ke Opsi C (RPC).
MAX_SCAN_ROWS=20000
