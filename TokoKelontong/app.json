{
  "expo": {
    "name": "MARKETPOS",
    "slug": "marketpos",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkOnLaunch": "always",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/b3b55795-dbed-43c2-94a6-728f7ac0a817"
    },
    "orientation": "portrait",
    "icon": "./assets/MarketPos.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDFB"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan akses kamera untuk mengambil foto produk dan scan barcode.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan akses galeri foto untuk memilih foto produk dan logo toko.",
        "NSPhotoLibraryAddUsageDescription": "Aplikasi membutuhkan izin untuk menyimpan foto ke galeri."
      }
    },
    "android": {
      "package": "com.rafi.marketpos",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/MarketPos.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan aplikasi mengakses kamera untuk scan barcode produk."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi mengakses galeri foto untuk memilih foto produk dan logo toko.",
          "cameraPermission": "Izinkan aplikasi mengakses kamera untuk mengambil foto produk."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b3b55795-dbed-43c2-94a6-728f7ac0a817"
      }
    },
    "owner": "rafirachmawan"
  }
}
