# Mode sumber data:
#   mock     -> data contoh, tanpa koneksi database (default)
#   api      -> baca data asli lewat admin-api lokal (Opsi B, read-only)
#   supabase -> rencana Opsi C, belum diaktifkan
VITE_DATA_MODE=mock

# Dipakai hanya jika VITE_DATA_MODE=api.
# Jalankan admin-api lebih dulu: cd admin-api && npm run dev
VITE_API_BASE_URL=http://127.0.0.1:8787

# Diisi hanya jika VITE_DATA_MODE=supabase (Opsi C).
# Gunakan anon key — JANGAN pernah memakai service_role key di aplikasi web.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
